# Veritabanı — İKİ SEÇENEK (birini seç):

# A) Kolay yerel test (PostgreSQL kurmana gerek yok — ÖNERİLEN):
#    web/ içinde: npm run setup:local
#    DATABASE_URL otomatik: file:./prisma/dev.db

# B) PostgreSQL (yayına yakın / Ayşe'nin eski kurulumu):
# DATABASE_URL="postgresql://postgres:SIFREN@localhost:5432/kimya"

# YAYIN (Neon) için şu formatta olacak:
# DATABASE_URL="postgresql://<kullanici>:<sifre>@<host>.neon.tech/kimya?sslmode=require"

# JWT imza anahtarı — en az 32 karakter, rastgele üret
# (Yayında MUTLAKA değiştir: https://randomkeygen.com)
JWT_SECRET="degistir-beni-en-az-32-karakterlik-rastgele-bir-anahtar"
